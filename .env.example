# Telegram Bot API Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram User ID of the primary administrator for notifications
ADMIN_ID=123456789

# SQLite Database path
DB_PATH=peacemirror_database.db

# Escalation ladder mute durations (in minutes): Step 2 (5m), Step 3 (15m), Step 4 (2h), Step 5 (24h)
MUTE_STEP_2_MINUTES=5
MUTE_STEP_3_MINUTES=15
MUTE_STEP_4_MINUTES=120
MUTE_STEP_5_MINUTES=1440

# Inactive days before resetting violation count
RESET_INACTIVE_DAYS=7
